#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=csw-remote-common.sh
source "$SCRIPT_DIR/csw-remote-common.sh"

BACKEND="${1:-}"
MIRROR_ID="${2:-}"

usage() {
  printf 'usage: test_%s <mirror-id>\n' "$BACKEND" >&2
}

case "$BACKEND" in
  cpu|cuda|rocm|sycl) ;;
  *)
    fail "unknown backend: $BACKEND"
    ;;
esac

if [[ "$MIRROR_ID" == "--help" && $# -eq 2 ]]; then
  usage
  exit 0
fi

[[ $# -eq 2 ]] || { usage; exit 1; }
[[ -n "${CSW_REMOTE_TASK_DIR:-}" ]] ||
  fail "CSW_REMOTE_TASK_DIR must name the local task directory"
[[ -d "$CSW_REMOTE_TASK_DIR" ]] ||
  fail "task directory is not a directory: $CSW_REMOTE_TASK_DIR"
[[ -n "${CSW_REMOTE_WORKSPACE:-}" ]] ||
  fail "CSW_REMOTE_WORKSPACE must name the selected checkout or worktree"
[[ -d "$CSW_REMOTE_WORKSPACE" ]] ||
  fail "workspace path is not a directory: $CSW_REMOTE_WORKSPACE"
[[ "$MIRROR_ID" =~ ^[A-Za-z0-9._-]+$ ]] ||
  fail "invalid mirror id: $MIRROR_ID"

# Resolve and validate all local inputs before opening remote.log or creating
# the SYCL configuration override.
resolve_workspace
load_profile "$BACKEND"
require_cmd timeout
require_cmd mktemp
require_cmd awk

TASK_DIR="$(cd -- "$CSW_REMOTE_TASK_DIR" && pwd -P)"
REMOTE_LOG="$TASK_DIR/remote.log"
: >>"$REMOTE_LOG" || fail "cannot append remote log: $REMOTE_LOG"
TASK_ID="${MIRROR_ID}-${BACKEND}"
validate_task_id "$TASK_ID"

SYNC="$SCRIPT_DIR/csw-remote-sync"
EXEC="$SCRIPT_DIR/csw-remote-exec"
CLEAN="$SCRIPT_DIR/csw-remote-clean"
for helper in "$SYNC" "$EXEC" "$CLEAN"; do
  [[ -x "$helper" ]] || fail "remote helper is not executable: $helper"
done

TEMP_CONFIG=
cleanup_temp_config() {
  if [[ -n "$TEMP_CONFIG" ]]; then
    rm -f -- "$TEMP_CONFIG"
  fi
}
trap cleanup_temp_config EXIT

if [[ "$BACKEND" == sycl ]]; then
  # The oneAPI setup script reads unset variables.  Keep REMOTE_SETUP empty in
  # an outside-checkout config and source setvars explicitly at every exec.
  TEMP_CONFIG="$(mktemp "${TMPDIR:-/tmp}/iom-csw-sycl-config.XXXXXX")"
  printf '%s|%s|%s|\n' "$PROFILE" "$SSH_HOST" "$REMOTE_BASE" >"$TEMP_CONFIG" ||
    fail "cannot create SYCL remote config override from $CONFIG_FILE"
  export CSW_REMOTE_CONFIG="$TEMP_CONFIG"
fi

record_failure() {
  local operation="$1" status="$2"
  printf 'runner failure operation=%s profile=%s mirror=%s exit=%s\n' \
    "$operation" "$BACKEND" "$TASK_ID" "$status" >>"$REMOTE_LOG"
  printf 'test_%s failed: operation=%s profile=%s mirror=%s exit=%s; full output: %s\n' \
    "$BACKEND" "$operation" "$BACKEND" "$TASK_ID" "$status" "$REMOTE_LOG" >&2
}

run_step() {
  local operation="$1" limit_seconds="$2"
  shift 2
  local status
  # Keep local helpers in the verifier's process group so cancellation also
  # reaches ssh/rsync instead of leaving a detached timeout group running.
  if timeout --foreground --kill-after=30s "${limit_seconds}s" "$@"; then
    return 0
  else
    status=$?
  fi
  record_failure "$operation" "$status"
  return "$status"
}

# Build an isolated, ignored directory in the remote mirror.  Every backend
# explicitly disables all other accelerators, and model-loading remains OFF.
BUILD_DIR="build/csw-runner-${BACKEND}"
CMAKE_FLAGS="-DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=ON -DIOM_TEST_REAL_MODEL_LOADING=OFF -DCUDA_ENABLED=OFF -DROCM_ENABLED=OFF -DSYCL_ENABLED=OFF"
case "$BACKEND" in
  cuda) CMAKE_FLAGS+=" -DCUDA_ENABLED=ON" ;;
  rocm) CMAKE_FLAGS+=" -DROCM_ENABLED=ON" ;;
  sycl) CMAKE_FLAGS+=" -DSYCL_ENABLED=ON" ;;
esac

REMOTE_PREFIX=
if [[ "$BACKEND" == sycl ]]; then
  REMOTE_PREFIX='set +u; source /opt/intel/oneapi/setvars.sh >/tmp/iom-setvars.log 2>&1; set -u;'
fi

run_remote() {
  local command="$1"
  if [[ -n "$REMOTE_PREFIX" ]]; then
    command="$REMOTE_PREFIX $command"
  fi
  run_step "$2" "$3" "$EXEC" "$BACKEND" "$TASK_ID" "$command"
}

# Each remote exec gets a fresh sync of this backend's mirror, including when
# the source is unchanged.  This keeps every operation tied to its exact
# selected worktree and makes the evidence auditable.
run_step sync 600 "$SYNC" "$BACKEND" "$TASK_ID"
run_remote "timeout --kill-after=30s 1800s cmake -S . -B $BUILD_DIR $CMAKE_FLAGS" configure 1860
run_step sync 600 "$SYNC" "$BACKEND" "$TASK_ID"
run_remote "timeout --kill-after=30s 1800s cmake --build $BUILD_DIR --parallel \"\$(nproc)\"" build 1860
run_step sync 600 "$SYNC" "$BACKEND" "$TASK_ID"

if [[ "$BACKEND" == cpu ]]; then
  TEST_COMMAND="timeout --kill-after=30s 900s ctest --test-dir $BUILD_DIR --no-tests=error --output-on-failure --timeout 300"
  TEST_LIMIT=1020
else
  TEST_REGEX="^iom_${BACKEND}_.*tests$|^iom_backend_coexistence_tests$"
  if [[ "$BACKEND" == sycl ]]; then
    TEST_COMMAND="flock -w 120 /tmp/agent-gpu0.lock timeout --kill-after=30s 1080s bash -c 'set -euo pipefail; timeout --kill-after=30s 120s sycl-ls | tee $BUILD_DIR/sycl-devices.log; if ! grep -Eiq \"level[-_ ]zero.*gpu|gpu.*level[-_ ]zero\" $BUILD_DIR/sycl-devices.log; then echo \"No Level Zero GPU found\" >&2; exit 1; fi; timeout --kill-after=30s 900s ctest --test-dir $BUILD_DIR --no-tests=error --output-on-failure --timeout 300 --parallel 1 -R \"$TEST_REGEX\"'"
  else
    TEST_COMMAND="flock -w 120 /tmp/agent-gpu0.lock timeout --kill-after=30s 900s ctest --test-dir $BUILD_DIR --no-tests=error --output-on-failure --timeout 300 --parallel 1 -R '$TEST_REGEX'"
  fi
  TEST_LIMIT=1260
fi
run_remote "$TEST_COMMAND" tests "$TEST_LIMIT"

# Keep failed mirrors for diagnosis.  Cleanup is attempted only after every
# remote operation has succeeded, and its own bounded failure is propagated.
run_step clean 300 "$CLEAN" "$BACKEND" "$TASK_ID"
printf 'test_%s passed: mirror=%s\n' "$BACKEND" "$TASK_ID"
