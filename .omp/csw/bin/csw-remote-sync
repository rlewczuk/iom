#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=csw-remote-common.sh
source "$SCRIPT_DIR/csw-remote-common.sh"

[[ $# -eq 2 ]] || fail "usage: csw-remote-sync <profile> <task-id>"
PROFILE_ARG="$1"
TASK_ID="$2"

require_cmd ssh
require_cmd rsync
require_cmd mktemp
resolve_workspace
validate_task_id "$TASK_ID"
load_profile "$PROFILE_ARG"
REMOTE_DIR="$(remote_dir_for "$TASK_ID")"

escape_rsync_pattern() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\[/\\[}"
  value="${value//\*/\\*}"
  value="${value//\?/\\?}"
  printf '%s' "$value"
}

FILTER_FILE="$(mktemp)"
UNVERSIONED_PATHS="$(mktemp)"
trap 'rm -f -- "$FILTER_FILE" "$UNVERSIONED_PATHS"' EXIT

# Git supplies the non-versioned paths so nested and repository-local ignore
# rules have the same meaning here that they do elsewhere in the workspace.
git -C "$WORKSPACE_ROOT" ls-files --others --exclude-standard -z \
  >"$UNVERSIONED_PATHS"
git -C "$WORKSPACE_ROOT" ls-files --others --ignored --exclude-standard \
  --directory -z >>"$UNVERSIONED_PATHS"

while IFS= read -r -d '' path; do
  case "$path" in
    _local | _local/*) continue ;;
    *$'\n'* | *$'\r'*)
      fail "non-versioned path contains a line break: $path"
      ;;
  esac
  printf '/%s\n' "$(escape_rsync_pattern "$path")" >>"$FILTER_FILE"
done <"$UNVERSIONED_PATHS"

# Create the destination first. This also validates SSH connectivity.
ssh "$SSH_HOST" "mkdir -p $(quote_single "$REMOTE_DIR")"

rsync -a --delete-delay --human-readable --prune-empty-dirs \
  --exclude='/.cswd' \
  --exclude='*/.cswd' \
  --include='/_local/' \
  --include='/_local/***' \
  --exclude='/.git' \
  --exclude='/.work/' \
  --exclude='/.worktrees/' \
  --exclude='/.remote-hosts.conf' \
  --exclude-from="$FILTER_FILE" \
  --filter=':- .gitignore' \
  "$WORKSPACE_ROOT/" "$SSH_HOST:$REMOTE_DIR/"

printf 'Synced %s %s -> %s:%s\n' \
  "$WORKSPACE_KIND" "$WORKSPACE_ROOT" "$SSH_HOST" "$REMOTE_DIR"
