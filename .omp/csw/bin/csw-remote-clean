#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=csw-remote-common.sh
source "$SCRIPT_DIR/csw-remote-common.sh"

[[ $# -eq 2 ]] || fail "usage: csw-remote-clean <profile> <task-id>"
PROFILE_ARG="$1"
TASK_ID="$2"

require_cmd ssh
resolve_workspace
validate_task_id "$TASK_ID"
load_profile "$PROFILE_ARG"
REMOTE_DIR="$(remote_dir_for "$TASK_ID")"

ssh "$SSH_HOST" "rm -rf -- $(quote_single "$REMOTE_DIR")"
printf 'Removed %s:%s\n' "$SSH_HOST" "$REMOTE_DIR"
