#!/usr/bin/env python3
"""Bounded csw-run verification, review evidence, and locked integration.

verify TASK --plan FILE --summary TEXT
  Plan: {"commands":[{"name":"gate","argv":["program","arg"],
  "timeout_seconds":900}],"total_timeout_seconds":7200}. Nonempty; no shell
  interpolation. All commands run in the exact worktree. CTest needs --timeout;
  SSH commands also need a remote-side timeout and bounded device lock.

review TASK --packet FILE
  Packet: {"commit":"full ID","base":"full ID","worktree":"absolute path",
  "round":1,"reviewers":[{"alias":"@csw-review","status":"success",
  "raw_report":"complete csw-review-commit Markdown","findings":[]}],
  "ledger":{"items":[]}}. BOTH @csw-review and @csw-review-2 are required.
  Status: success|failed|unavailable|quota. Failed outcomes require error text.
  Each finding: id (stable task-local ID), source_id (reviewer issue number),
  severity, title, location, evidence, impact, remedy. Every numbered Markdown
  finding must be represented with its original severity. Shared IDs deduplicate
  defects while preserving every source; semantic adjudication is the verifier's.
  ledger.items must cover every current AND historical ID exactly once:
  {id,status:open|solved|rejected|waived,evidence?}. Non-open requires evidence;
  solved also requires original_commit and fixing_commit (this candidate).
  Waived items require consent/source and cannot bypass critical/high findings.
  If neither review succeeded, only two unavailable/quota outcomes may request
  an availability waiver: {commit,round,consent,source} with actual user evidence.
  status TASK returns next_review_round and retained ledger/receipts.

integrate TASK
  Requires matching verified/review receipts. Only the short head check,
  fast-forward and metadata finalization hold the repository lock. Interrupted
  finalization is journaled and recoverable by repeating this command.

All commands emit JSON. Exit 0: success; 2: blocked/failed/retryable (see code);
3: helper-managed rebase conflict requiring original-owner edits. Logs and state
stay in local worktree Git state, outside the checkout's versioned files.
"""
from __future__ import annotations

import argparse
from contextlib import contextmanager
import copy
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import re
import runpy
import signal
import subprocess
import sys
import tempfile
import time
from types import SimpleNamespace
from typing import Any


worker = SimpleNamespace(**runpy.run_path(str(Path(__file__).resolve().with_name("csw_run_worker"))))
ALIASES = {"@csw-review", "@csw-review-2"}
SEVERITIES = ("low", "medium", "high", "critical")
ISSUE = re.compile(r"^\s*(\d+)\.\s+\*\*\[(critical|high|medium|low)\]", re.MULTILINE | re.IGNORECASE)
MAX_ATTEMPT_SECONDS = 7200
STATE_FILE = "csw-verifier-state.json"


def result(ok: bool, code: str = "ok", **fields: Any) -> dict[str, Any]:
    return {"schema_version": 1, "ok": ok, "code": code, **fields}


def digest(value: Any) -> str:
    return hashlib.sha256(json.dumps(value, sort_keys=True).encode()).hexdigest()


def nonempty(value: Any, label: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise worker.TaskError(f"{label} must be nonempty text")
    return value


def read_json(value: str) -> dict[str, Any]:
    if value.lstrip().startswith("{"):
        payload = json.loads(value)
    else:
        payload = json.loads(Path(value).read_text(encoding="utf-8"))
    if not isinstance(payload, dict):
        raise worker.TaskError("expected a JSON object")
    return payload


def state_path(wt: Path) -> Path:
    return worker.absolute_git_dir(wt) / STATE_FILE


def load(wt: Path) -> dict[str, Any]:
    path = state_path(wt)
    return read_json(str(path)) if path.exists() else {}


def save(wt: Path, data: dict[str, Any]) -> None:
    path = state_path(wt)
    fd, temporary = tempfile.mkstemp(prefix=STATE_FILE + ".", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(data, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


@contextmanager
def leaf_lock(repo: Path, task: str):
    with worker.integration_lock(repo):
        wt, _ = worker.load_state(repo, task)
    with state_path(wt).with_suffix(".lock").open("a") as stream:
        try:
            fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise worker.TaskError("leaf verifier lock busy; another operation owns this worktree") from exc
        try:
            yield wt
        finally:
            fcntl.flock(stream, fcntl.LOCK_UN)


def command_plan(value: str) -> dict[str, Any]:
    raw = read_json(value)
    commands = raw.get("commands")
    if not isinstance(commands, list) or not commands:
        raise worker.TaskError("plan requires a nonempty commands array")
    total = raw.get("total_timeout_seconds", MAX_ATTEMPT_SECONDS)
    if (isinstance(total, bool) or not isinstance(total, (int, float))
            or not math.isfinite(total) or not 0 < total <= MAX_ATTEMPT_SECONDS):
        raise worker.TaskError("total_timeout_seconds must be finite, positive and at most 7200")
    normalized = []
    names = set()
    for entry in commands:
        if not isinstance(entry, dict):
            raise worker.TaskError("each gate must be an object")
        name = worker.single_line(nonempty(entry.get("name"), "gate name"), "gate name")
        if name in names:
            raise worker.TaskError(f"duplicate gate name: {name}")
        names.add(name)
        argv, timeout = entry.get("argv"), entry.get("timeout_seconds")
        if (not isinstance(argv, list) or not argv
                or any(not isinstance(arg, str) or "\0" in arg for arg in argv) or not argv[0]):
            raise worker.TaskError(f"{name}: argv must be a nonempty argument array")
        if (isinstance(timeout, bool) or not isinstance(timeout, (int, float))
                or not math.isfinite(timeout) or not 0 < timeout <= total):
            raise worker.TaskError(f"{name}: timeout must be positive and no greater than the total budget")
        if Path(argv[0]).name == "ctest":
            limits = [arg.split("=", 1)[1] for arg in argv if arg.startswith("--timeout=")]
            limits += [argv[i + 1] for i, arg in enumerate(argv[:-1]) if arg == "--timeout"]
            if not limits or any(not math.isfinite(float(limit)) or float(limit) <= 0 for limit in limits):
                raise worker.TaskError("CTest requires a positive finite --timeout per test")
        normalized.append({"name": name, "argv": argv, "timeout_seconds": float(timeout)})
    return {"commands": normalized, "total_timeout_seconds": float(total)}


def stop_group(process: subprocess.Popen) -> None:
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass
    finally:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait(timeout=5)


def run_gate(wt: Path, gate: dict[str, Any], deadline: float, log: Path) -> dict[str, Any]:
    started = time.monotonic()
    observed = {"name": gate["name"], "argv": gate["argv"], "log": str(log),
                "ok": False, "timed_out": False, "returncode": None}
    process = None
    with log.open("wb") as stream:
        remaining = min(gate["timeout_seconds"], deadline - started)
        if remaining <= 0:
            observed.update(timed_out=True, error="total verification deadline exceeded")
        else:
            try:
                process = subprocess.Popen(gate["argv"], cwd=wt, stdout=stream,
                                           stderr=subprocess.STDOUT, start_new_session=True)
                try:
                    observed["returncode"] = process.wait(timeout=remaining)
                    observed["ok"] = observed["returncode"] == 0
                    try:
                        os.killpg(process.pid, 0)
                    except ProcessLookupError:
                        pass
                    else:
                        observed.update(ok=False, error="gate left background processes running")
                        stop_group(process)
                except subprocess.TimeoutExpired:
                    stop_group(process)
                    observed.update(timed_out=True, returncode=process.returncode)
            except OSError as exc:
                observed["error"] = str(exc)
            except BaseException:
                if process is not None:
                    stop_group(process)
                raise
    observed["elapsed_seconds"] = round(time.monotonic() - started, 3)
    return observed


def snapshot(repo: Path, task: str) -> dict[str, Any]:
    checked = worker.check_task(repo, task, None)
    if checked["status"] not in {"ready", "verified"}:
        raise worker.TaskError("verification requires a ready or verified candidate")
    checked["tree"] = worker.git(Path(checked["worktree"]), "rev-parse", checked["commit"] + "^{tree}").stdout.strip()
    return checked


def matching(receipt: Any, current: dict[str, Any]) -> bool:
    return isinstance(receipt, dict) and all(receipt.get(key) == current.get(key)
                                            for key in ("commit", "base", "tree", "worktree"))


def successful(receipt: Any) -> bool:
    return (isinstance(receipt, dict) and isinstance(receipt.get("plan"), dict)
            and bool(receipt.get("gates"))
            and len(receipt["gates"]) == len(receipt["plan"].get("commands", []))
            and all(gate.get("ok") is True for gate in receipt["gates"]))


def conflict(repo: Path, task: str, wt: Path, error: str) -> dict[str, Any]:
    _, state = worker.load_state(repo, task)
    paths = worker.git(wt, "diff", "--name-only", "--diff-filter=U", "-z").stdout.split("\0")
    return result(False, "repair_needed", task=task, worktree=str(wt),
                  onto=state.get("pending_rebase_onto"), conflicts=[path for path in paths if path], error=error)


def verify(repo: Path, task: str, wt: Path, plan_arg: str, summary: str) -> dict[str, Any]:
    plan = command_plan(plan_arg)
    summary = worker.single_line(summary, "verification summary")
    deadline = time.monotonic() + plan["total_timeout_seconds"]
    data = load(wt)
    with worker.integration_lock(repo):
        _, state = worker.load_state(repo, task)
        integration = worker.validate_integration(state)
        if integration != repo:
            raise worker.TaskError("selected repository is not the integration checkout")
        if state.get("pending_rebase_onto"):
            return conflict(repo, task, wt, "owner edits and explicit verifier continue-rebase handoff required")
        canonical = worker.head(repo)
        current = snapshot(repo, task)
        receipt = data.get("verification_receipt")
        if (current["base"] == canonical and current["status"] == "verified"
                and matching(receipt, current) and successful(receipt) and receipt["plan"] == plan):
            worker.validate_metadata_snapshot(repo, state, current["commit"], require_verified=True)
            return result(True, "verified", task=task, receipt=receipt, reused=True)
        data.pop("verification_receipt", None)
        data.pop("review_receipt", None)
        save(wt, data)
        if current["base"] != canonical:
            try:
                worker.rebase_task(repo, task, canonical)
            except worker.RebaseConflict as exc:
                return conflict(repo, task, wt, str(exc))
        current = snapshot(repo, task)

    log_dir = Path(tempfile.mkdtemp(prefix="csw-verify-", dir=state_path(wt).parent))
    data["active_attempt"] = {
        "commit": current["commit"], "base": current["base"], "plan": plan, "log_dir": str(log_dir),
    }
    save(wt, data)
    gates = []
    for index, gate in enumerate(plan["commands"]):
        gates.append(run_gate(wt, gate, deadline, log_dir / f"gate-{index + 1}.log"))
        if not gates[-1]["ok"]:
            break
    receipt = {key: current[key] for key in ("commit", "base", "tree", "worktree")}
    receipt.update(plan=plan, gates=gates, summary=summary, log_dir=str(log_dir))
    data["last_attempt"] = receipt
    data.pop("active_attempt", None)
    save(wt, data)
    with worker.integration_lock(repo):
        if not all(gate["ok"] for gate in gates):
            failed = gates[-1]
            try:
                unchanged = snapshot(repo, task)
                if matching(receipt, unchanged):
                    error = f"{failed['name']}: {json.dumps(failed['argv'])}; exit={failed['returncode']}; timeout={failed['timed_out']}; log={failed['log']}"
                    worker.annotate_task(repo, task, task, "failed", summary, [], [error])
                    retained = worker.commit_task(repo, task, unchanged["status"], None)
                    receipt["retained_commit"] = retained["commit"]
            except (worker.TaskError, worker.TaskCtlError, OSError) as exc:
                receipt["evidence_error"] = str(exc)
            save(wt, data)
            return result(False, "gate_timeout" if failed["timed_out"] else "gate_failed", task=task, receipt=receipt)
        if not matching(receipt, snapshot(repo, task)):
            raise worker.TaskError("gate changed the candidate commit, tree or base")
        if worker.head(repo) != current["base"]:
            return result(False, "needs_verification", task=task, receipt=receipt,
                          reason="canonical head advanced during gates; replay before review")
        evidence = [f"{gate['name']}: {json.dumps(gate['argv'])} — exit {gate['returncode']}; log {gate['log']}" for gate in gates]
        worker.annotate_task(repo, task, task, "verified", summary, evidence, [])
        worker.commit_task(repo, task, "verified", None)
        final = snapshot(repo, task)
        if final["tree"] != current["tree"] or final["base"] != current["base"]:
            raise worker.TaskError("verified commit no longer has the tested tree/base")
        receipt["commit"] = final["commit"]
        data["verification_receipt"] = receipt
        save(wt, data)
    return result(True, "verified", task=task, receipt=receipt, reused=False)


def normalize_review(reviewer: Any, commit: str, base: str, wt: Path) -> dict[str, Any]:
    if not isinstance(reviewer, dict):
        raise worker.TaskError("reviewer outcome must be an object")
    alias, status = reviewer.get("alias"), reviewer.get("status")
    if not isinstance(alias, str) or alias not in ALIASES:
        raise worker.TaskError("invalid reviewer alias")
    if not isinstance(status, str) or status not in {"success", "failed", "unavailable", "quota"}:
        raise worker.TaskError(f"{alias}: missing settled reviewer outcome")
    raw = nonempty(reviewer.get("raw_report"), "original reviewer report/error")
    reported = ISSUE.findall(raw)
    if status == "success":
        for heading in ("## Commit review", "### Issues", "### Summary"):
            if not re.search(r"^" + re.escape(heading) + r"\s*$", raw, re.MULTILINE):
                raise worker.TaskError(f"{alias}: incomplete report, missing {heading}")
        for field, value in (("Commit", commit), ("Baseline", base), ("Worktree", str(wt))):
            line = re.search(r"^- " + field + r":\s*(.+)$", raw, re.MULTILINE)
            if not line or value not in line.group(1):
                raise worker.TaskError(f"{alias}: report {field} does not match the supplied snapshot")
        for field in ("Scope", "Assessment", "Verification", "Limitations"):
            if not re.search(r"^- " + field + r":\s*\S", raw, re.MULTILINE):
                raise worker.TaskError(f"{alias}: report missing {field}")
        counts = re.search(r"Counts:\s*critical (\d+), high (\d+), medium (\d+), low (\d+)", raw, re.IGNORECASE)
        if not counts or [int(n) for n in counts.groups()] != [sum(sev.lower() == level for _, sev in reported) for level in reversed(SEVERITIES)]:
            raise worker.TaskError(f"{alias}: report issue counts do not match its findings")
        if not reported and "no actionable issues found" not in raw.lower():
            raise worker.TaskError(f"{alias}: missing explicit no-findings result")
        if re.search(r"(?:review|coverage)\s+(?:is\s+)?incomplete|incomplete\s+(?:review|coverage)", raw, re.IGNORECASE):
            raise worker.TaskError(f"{alias}: incomplete coverage cannot approve a commit")
    else:
        nonempty(reviewer.get("error"), f"{alias} failure evidence")
    findings = reviewer.get("findings")
    if not isinstance(findings, list) or len(findings) != len(reported):
        raise worker.TaskError(f"{alias}: every raw finding must be preserved in the normalized list")
    seen_sources = set()
    normalized = []
    for item, (source_id, severity) in zip(findings, reported):
        if not isinstance(item, dict):
            raise worker.TaskError("finding must be an object")
        for field in ("id", "source_id", "severity", "title", "location", "evidence", "impact", "remedy"):
            nonempty(item.get(field), f"finding {field}")
        if item["source_id"] != source_id or item["severity"] != severity.lower() or source_id in seen_sources:
            raise worker.TaskError(f"{alias}: normalized finding lost its original ID/severity")
        seen_sources.add(source_id)
        normalized.append(copy.deepcopy(item))
    return {"alias": alias, "status": status, "raw_report": raw, "findings": normalized, "error": reviewer.get("error")}


def review(repo: Path, task: str, wt: Path, packet_arg: str) -> dict[str, Any]:
    packet = read_json(packet_arg)
    data = load(wt)
    receipt = data.get("verification_receipt")
    current = snapshot(repo, task)
    if not matching(receipt, current) or not successful(receipt):
        raise worker.TaskError("review requires an exact successful verification receipt")
    if (packet.get("commit") != receipt["commit"] or packet.get("base") != receipt["base"]
            or packet.get("worktree") != str(wt)):
        return result(False, "stale_review", task=task, expected_commit=receipt["commit"])
    number = packet.get("round")
    prior_round = data.get("review_round", 0)
    packet_digest = digest(packet)
    if number == prior_round and packet_digest == data.get("review_digest"):
        return data["review_result"]
    waiver_retry = (
        number == prior_round and data.get("review_result", {}).get("code") == "waiver_required"
        and "waiver" in packet
        and digest({key: value for key, value in packet.items() if key != "waiver"}) == data.get("review_digest")
    )
    if type(number) is not int or (number != prior_round + 1 and not waiver_retry):
        raise worker.TaskError("review round must equal status.next_review_round, or add only consent to the pending waiver")
    data.pop("review_receipt", None)
    save(wt, data)
    reviewers = packet.get("reviewers")
    if not isinstance(reviewers, list) or len(reviewers) != 2:
        raise worker.TaskError("both settled reviewer outcomes are required")
    normalized = [normalize_review(item, receipt["commit"], receipt["base"], wt) for item in reviewers]
    if {item["alias"] for item in normalized} != ALIASES:
        raise worker.TaskError("both distinct reviewer aliases are required exactly once")
    ledger = copy.deepcopy(data.get("review_ledger", {}))
    current_ids = set()
    for report in normalized:
        for item in report["findings"]:
            finding_id = item["id"]
            current_ids.add(finding_id)
            source = {"alias": report["alias"], "source_id": item["source_id"], "commit": receipt["commit"], "round": number}
            if finding_id not in ledger:
                ledger[finding_id] = {**item, "original_commit": receipt["commit"], "sources": []}
            finding = ledger[finding_id]
            finding["severity"] = max((finding["severity"], item["severity"]), key=SEVERITIES.index)
            finding["sources"].append({**source, "finding": item})
            finding["status"] = "open"
    dispositions = packet.get("ledger")
    if not isinstance(dispositions, dict) or not isinstance(dispositions.get("items"), list):
        raise worker.TaskError("complete adjudicated ledger.items is required")
    seen = set()
    for disposition in dispositions["items"]:
        if not isinstance(disposition, dict):
            raise worker.TaskError("ledger disposition must be an object")
        finding_id = nonempty(disposition.get("id"), "ledger ID")
        status = disposition.get("status")
        if (finding_id not in ledger or finding_id in seen or not isinstance(status, str)
                or status not in {"open", "solved", "rejected", "waived"}):
            raise worker.TaskError("duplicate, unsourced or invalid finding disposition")
        seen.add(finding_id)
        finding = ledger[finding_id]
        if status != "open":
            nonempty(disposition.get("evidence"), "closure counterevidence/verification")
        if status == "solved":
            if (finding_id in current_ids or disposition.get("original_commit") != finding["original_commit"]
                    or disposition.get("fixing_commit") != receipt["commit"]
                    or finding["original_commit"] == receipt["commit"]):
                raise worker.TaskError("solved finding requires a new fixing commit and confirming review evidence")
        if status == "waived":
            nonempty(disposition.get("consent"), "actual developer consent")
            nonempty(disposition.get("source"), "developer consent artifact")
        finding["status"] = status
        finding["disposition"] = copy.deepcopy(disposition)
    if seen != set(ledger):
        raise worker.TaskError("ledger omitted current or historical findings")
    successful_review = any(item["status"] == "success" for item in normalized)
    availability = all(item["status"] in {"unavailable", "quota"} for item in normalized)
    waiver = packet.get("waiver")
    if waiver is not None:
        if (not availability or not isinstance(waiver, dict) or waiver.get("commit") != receipt["commit"]
                or type(waiver.get("round")) is not int or waiver.get("round") != number):
            raise worker.TaskError("availability waiver must match this exact commit/round and both availability failures")
        nonempty(waiver.get("consent"), "actual developer consent")
        nonempty(waiver.get("source"), "developer consent artifact")
    blocking = [item for item in ledger.values() if item["severity"] in {"critical", "high"}
                and item["status"] in {"open", "waived"}]
    approved = (successful_review or waiver is not None) and not blocking
    code = "review_permitted" if approved else ("review_blocked" if blocking else ("waiver_required" if availability else "review_failed"))
    review_file = worker.spec_path(repo, task).with_name("review.md")
    text = [f"\n## Review round {number}\n", f"- Commit: {receipt['commit']}", f"- Baseline: {receipt['base']}",
            f"- Worktree: {wt}", f"- Gate: {code}", f"- Verification logs: {receipt['log_dir']}\n"]
    for item in normalized:
        text.extend([f"### {item['alias']} — {item['status']}\n", item["raw_report"], ""])
    for section, statuses in (("Open issues", {"open"}), ("Solved issues", {"solved"}), ("Rejected / waived issues", {"rejected", "waived"})):
        text.append(f"### {section}\n")
        values = [item for item in ledger.values() if item["status"] in statuses]
        text.append("```json\n" + json.dumps(values, indent=2, sort_keys=True) + "\n```\n")
    if waiver is not None:
        text.append("### Developer availability waiver\n\n" + json.dumps(waiver, indent=2) + "\n")
    with review_file.open("a", encoding="utf-8") as stream:
        stream.write("\n".join(text) + "\n")
        stream.flush()
        os.fsync(stream.fileno())
    output = result(approved, code, task=task, commit=receipt["commit"], round=number,
                    review_file=str(review_file), ledger=ledger, blocking_ids=[item["id"] for item in blocking])
    data.update(review_round=number, review_digest=packet_digest, review_ledger=ledger, review_result=output,
                review_receipt={"commit": receipt["commit"], "verification_digest": digest(receipt),
                                "approved": approved, "review_file": str(review_file), "round": number})
    save(wt, data)
    return output


def integrate(repo: Path, task: str, wt: Path) -> dict[str, Any]:
    with worker.integration_lock(repo):
        data = load(wt)
        receipt, review_receipt = data.get("verification_receipt"), data.get("review_receipt", {})
        _, state = worker.load_state(repo, task)
        if worker.validate_integration(state) != repo:
            raise worker.TaskError("selected repository is not the integration checkout")
        worker.require_clean(wt, "task worktree")
        if (not successful(receipt) or receipt.get("commit") != worker.head(wt)
                or receipt.get("worktree") != str(wt) or not review_receipt.get("approved")
                or review_receipt.get("commit") != receipt["commit"]
                or review_receipt.get("verification_digest") != digest(receipt)):
            return result(False, "review_not_permitted", task=task)
        current = worker.head(repo)
        candidate = receipt["commit"]
        pending = data.get("integration_pending") == {"commit": candidate, "base": receipt["base"]}
        contained = worker.is_ancestor(repo, candidate, current)
        if contained and (pending or data.get("integrated")):
            try:
                if worker.task_config(repo, task)["status"] != "done":
                    finalized = worker.validate_metadata_snapshot(repo, state, candidate, require_verified=True)
                    worker.mark_tasks_done(repo, finalized)
                proof = {"integration_head": current, "previous_head": receipt["base"], "commit": candidate,
                         "task_id": worker.canonical_task(task), "status": "done", "recovered": pending}
                data.pop("integration_pending", None)
                data["integrated"] = proof
                save(wt, data)
                return result(True, "integrated", task=task, proof=proof)
            except (worker.TaskError, worker.TaskCtlError, OSError) as exc:
                return result(False, "integration_recovery_needed", task=task, error=str(exc))
        if current != receipt["base"]:
            return result(False, "needs_verification", task=task, expected_base=receipt["base"], current_base=current)
        if not matching(receipt, snapshot(repo, task)):
            raise worker.TaskError("tested snapshot changed before integration")
        data["integration_pending"] = {"commit": candidate, "base": receipt["base"]}
        save(wt, data)
        try:
            proof = worker.integrate_task(repo, task)
        except (worker.TaskError, worker.TaskCtlError, OSError) as exc:
            return result(False, "integration_recovery_needed", task=task, error=str(exc),
                          canonical_head=worker.head(repo), candidate=candidate)
        data.pop("integration_pending", None)
        data["integrated"] = proof
        save(wt, data)
        return result(True, "integrated", task=task, proof=proof)


def status(repo: Path, task: str, wt: Path) -> dict[str, Any]:
    data = load(wt)
    return result(True, task=task, helper=worker.show_task(repo, task), state=data,
                  next_review_round=data.get("review_round", 0) + 1, state_path=str(state_path(wt)))


def parser() -> argparse.ArgumentParser:
    command = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    command.add_argument("--repo", default=".")
    command.add_argument("--pretty", action="store_true")
    sub = command.add_subparsers(dest="command", required=True)
    gate = sub.add_parser("verify")
    gate.add_argument("task")
    gate.add_argument("--plan", required=True)
    gate.add_argument("--summary", required=True)
    review_cmd = sub.add_parser("review")
    review_cmd.add_argument("task")
    review_cmd.add_argument("--packet", required=True)
    for name in ("integrate", "status"):
        sub.add_parser(name).add_argument("task")
    return command


def interrupted(signum: int, frame: Any) -> None:
    raise KeyboardInterrupt


def main() -> int:
    args = parser().parse_args()
    signal.signal(signal.SIGTERM, interrupted)
    try:
        repo = worker.root_for(Path(args.repo))
        task = worker.validate_target(args.task, branch_safe=True)
        with leaf_lock(repo, task) as wt:
            if args.command == "verify":
                output = verify(repo, task, wt, args.plan, args.summary)
            elif args.command == "integrate":
                output = integrate(repo, task, wt)
            else:
                with worker.integration_lock(repo):
                    output = review(repo, task, wt, args.packet) if args.command == "review" else status(repo, task, wt)
    except KeyboardInterrupt:
        output = result(False, "interrupted", error="operation interrupted; active local gate process group stopped")
    except worker.RebaseConflict as exc:
        output = result(False, "repair_needed", error=str(exc))
    except (worker.TaskError, worker.TaskCtlError, OSError, ValueError, OverflowError) as exc:
        code = "retryable_lock" if "lock busy" in str(exc) else "invalid_or_failed"
        output = result(False, code, error=str(exc))
    print(json.dumps(output, indent=2 if args.pretty else None, sort_keys=True))
    return 0 if output["ok"] else (3 if output["code"] == "repair_needed" else 2)


if __name__ == "__main__":
    raise SystemExit(main())
