#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=csw-remote-common.sh
source "$SCRIPT_DIR/csw-remote-common.sh"

[[ $# -ge 3 ]] || fail "usage: csw-remote-exec <profile> <task-id> <command...>"
PROFILE_ARG="$1"
TASK_ID="$2"
shift 2
COMMAND="$*"
require_task_directory
log_execution exec "$PROFILE_ARG" "$TASK_ID" "$@"


require_cmd ssh
resolve_workspace
validate_task_id "$TASK_ID"
load_profile "$PROFILE_ARG"
REMOTE_DIR="$(remote_dir_for "$TASK_ID")"

REMOTE_SCRIPT="set -euo pipefail; cd $(quote_single "$REMOTE_DIR");"
if [[ -n "${REMOTE_SETUP:-}" ]]; then
  REMOTE_SCRIPT+=" ${REMOTE_SETUP};"
fi
REMOTE_SCRIPT+=" ${COMMAND}"

run_logged ssh "$SSH_HOST" "bash -lc $(quote_single "$REMOTE_SCRIPT")"
