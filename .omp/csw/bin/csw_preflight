#!/usr/bin/env python3
"""Deterministically discover and validate a CSW workflow environment.

Usage:
    .omp/csw/bin/csw_preflight [--repo PATH]
        [--workflow boss|csw-run|csw-run-worker]
        [--omp PROGRAM] [--pretty]

The program resolves PATH to its Git worktree root, records HEAD, branch, and
the complete porcelain status, then runs ``omp config list --json`` and
``omp models --json`` from that root.  It reads only the project-owned agent
profiles required by the selected workflow.  It resolves effective model role
chains and per-agent overrides, checks model/thinking availability, and
validates each profile's fixed model, tools, spawn, advisor, and prewalk
contract.  No OMP configuration file or database is read directly.

Output is one stable JSON object with ``schema_version``, ``workflow``, ``ok``,
``git``, selected effective ``settings``, normalized ``roles``, the relevant
``models`` and total catalog count, resolved ``agents``, and sorted ``errors``.
Preserve this object verbatim as the workflow's environment evidence.  Exit
status 0 means ``ok: true``; status 2 means a concrete configuration or
discovery blocker.

To add a workflow, define its tuple of ``AgentContract`` values and minimum
task recursion depth in ``WORKFLOWS``.  Add a behavioral fixture covering its
healthy contract and at least one rejected effective override.  Keep output
additive and bump ``schema_version`` before making an incompatible field or
meaning change so every consuming skill can migrate explicitly.
"""

from __future__ import annotations

import argparse
import ast
from dataclasses import dataclass
import json
import re
import subprocess
import sys
from pathlib import Path
from typing import Any


THINKING_LEVELS = frozenset(("off", "minimal", "low", "medium", "high", "xhigh", "max"))
THINKING_SUFFIX = re.compile(r":([A-Za-z][A-Za-z0-9_-]*)$")
CONFIG_PATHS = (
    "modelRoles",
    "task.agentModelOverrides",
    "task.agentAdvisor",
    "task.agentPrewalk",
    "task.disabledAgents",
    "task.maxRecursionDepth",
)
READ_ONLY_TOOLS = ("ast_grep", "glob", "grep", "lsp", "read")
LOOKUP_TOOLS = (*READ_ONLY_TOOLS, "bash", "web_search")
BUILDER_TOOLS = (*READ_ONLY_TOOLS, "ast_edit", "bash", "edit", "write")


@dataclass(frozen=True)
class AgentContract:
    name: str
    model: str
    tools: tuple[str, ...]
    spawns: tuple[str, ...] = ()


BOSS_AGENTS = (
    AgentContract("boss-errand", "@smol", LOOKUP_TOOLS),
    AgentContract("scout", "@smol", READ_ONLY_TOOLS),
    AgentContract("boss-reviewer", "@task", READ_ONLY_TOOLS),
    AgentContract("boss-builder-fast", "@smol", BUILDER_TOOLS),
    AgentContract("boss-builder-fast-deep", "@smol", BUILDER_TOOLS),
    AgentContract("boss-builder", "@task", BUILDER_TOOLS),
    AgentContract("boss-builder-deep", "@task", BUILDER_TOOLS),
    AgentContract("boss-builder-strong", "@slow", BUILDER_TOOLS),
    AgentContract("boss-builder-strong-deep", "@slow", BUILDER_TOOLS),
    AgentContract("boss-advisor", "@advisor", ()),
    AgentContract("boss-advocate-fast", "@smol", LOOKUP_TOOLS),
    AgentContract("boss-advocate", "@task", LOOKUP_TOOLS),
    AgentContract("boss-advocate-strong", "@slow", LOOKUP_TOOLS),
    AgentContract("csw-plan-facts", "@task", READ_ONLY_TOOLS),
)
SPEC_RUN_ALL_AGENTS = (
    AgentContract("spec-run-all-implementer", "@implementer", BUILDER_TOOLS, ("spec-run-debug",)),
    AgentContract("spec-run-debug", "@slow", (*READ_ONLY_TOOLS, "bash")),
)
CSW_RUN_WORKER_AGENTS = (SPEC_RUN_ALL_AGENTS[1],)
WORKFLOWS = {
    "boss": (BOSS_AGENTS, 1),
    "csw-run": (SPEC_RUN_ALL_AGENTS, 2),
    "csw-run-worker": (CSW_RUN_WORKER_AGENTS, 2),
}


class Preflight:
    def __init__(self, repo: Path, omp: str, workflow: str) -> None:
        self.repo = repo.resolve()
        self.omp = omp
        self.workflow = workflow
        self.contracts, self.minimum_depth = WORKFLOWS[workflow]
        self.errors: list[str] = []
        self.config: dict[str, Any] | None = None
        self.models: list[dict[str, Any]] = []
        self.settings: dict[str, Any] = {}
        self.roles: dict[str, str] = {}
        self.overrides: dict[str, str] = {}
        self.disabled: set[str] = set()
        self.agent_advisor: Any = None
        self.agent_prewalk: Any = None
        self.profile_data: dict[str, dict[str, Any]] = {}

    def run_command(
        self,
        command: list[str],
        label: str,
        *,
        cwd: Path | None = None,
        allowed_returncodes: tuple[int, ...] = (0,),
    ) -> subprocess.CompletedProcess[str] | None:
        try:
            result = subprocess.run(
                command,
                cwd=cwd or self.repo,
                text=True,
                capture_output=True,
                check=False,
            )
        except OSError as exc:
            self.errors.append(f"{label} command failed: {' '.join(command)}: {exc}")
            return None
        if result.returncode not in allowed_returncodes:
            detail = (result.stderr or result.stdout).strip().replace("\n", " ")
            self.errors.append(f"{label} command failed: {detail or f'exit status {result.returncode}'}")
            return None
        return result

    def run_json(self, args: list[str], label: str) -> Any | None:
        command = [self.omp, *args]
        result = self.run_command(command, label)
        if result is None:
            return None
        try:
            return json.loads(result.stdout)
        except (TypeError, json.JSONDecodeError) as exc:
            self.errors.append(f"{label} returned invalid JSON: {exc}")
            return None

    def load_git(self) -> dict[str, Any]:
        root_result = self.run_command(
            ["git", "-C", str(self.repo), "rev-parse", "--show-toplevel"],
            "git repository discovery",
        )
        if root_result is None:
            return {}
        self.repo = Path(root_result.stdout.strip()).resolve()

        head = self.run_command(["git", "-C", str(self.repo), "rev-parse", "HEAD^{commit}"], "git HEAD discovery")
        branch = self.run_command(
            ["git", "-C", str(self.repo), "symbolic-ref", "--quiet", "--short", "HEAD"],
            "git branch discovery",
            allowed_returncodes=(0, 1),
        )
        branch_name = branch.stdout.strip() if branch is not None and branch.returncode == 0 else None
        status = self.run_command(
            ["git", "-C", str(self.repo), "status", "--short", "--untracked-files=all"],
            "git worktree discovery",
        )
        status_lines = status.stdout.splitlines() if status is not None else []
        return {
            "repo_root": str(self.repo),
            "head": head.stdout.strip() if head is not None else None,
            "branch": branch_name,
            "detached": branch_name is None,
            "clean": status is not None and not status_lines,
            "status": status_lines,
        }

    def load_effective_data(self) -> None:
        config = self.run_json(["config", "list", "--json"], "omp config list --json")
        models = self.run_json(["models", "--json"], "omp models --json")
        if isinstance(config, dict):
            self.config = config
        elif config is not None:
            self.errors.append("omp config list --json returned a JSON value, not an object")
        if isinstance(models, dict):
            raw_models = models.get("models")
            if not isinstance(raw_models, list):
                self.errors.append("omp models --json is missing a models array")
            else:
                for index, model in enumerate(raw_models):
                    if not isinstance(model, dict):
                        self.errors.append(f"omp models --json models[{index}] is not an object")
                        continue
                    missing = [key for key in ("selector", "provider", "id", "thinking") if key not in model]
                    if missing:
                        self.errors.append(
                            f"omp models --json models[{index}] is missing required field(s): {', '.join(missing)}"
                        )
                        continue
                    if not all(isinstance(model[key], str) and model[key] for key in ("selector", "provider", "id")):
                        self.errors.append(f"omp models --json models[{index}] has invalid identity fields")
                        continue
                    self.models.append(model)
        elif models is not None:
            self.errors.append("omp models --json returned a JSON value, not an object")

    @staticmethod
    def _setting(config: dict[str, Any], path: str, errors: list[str]) -> Any:
        if path not in config:
            errors.append(f"effective setting {path!r} is missing")
            return None
        record = config[path]
        if not isinstance(record, dict) or "value" not in record:
            errors.append(f"effective setting {path!r} is malformed (expected an object with value)")
            return None
        return record["value"]

    def parse_settings(self) -> None:
        if self.config is None:
            return
        for path in CONFIG_PATHS:
            self.settings[path] = self._setting(self.config, path, self.errors)

        roles = self.settings.get("modelRoles")
        if isinstance(roles, dict):
            for key, value in roles.items():
                if not isinstance(key, str) or not key:
                    self.errors.append("effective setting modelRoles contains an invalid role name")
                elif not isinstance(value, str) or not value.strip():
                    self.errors.append(f"effective setting modelRoles[{key!r}] must be a nonempty string")
                else:
                    self.roles[key.lstrip("@")] = value.strip()
        elif roles is not None:
            self.errors.append("effective setting modelRoles must be an object")

        overrides = self.settings.get("task.agentModelOverrides")
        if isinstance(overrides, dict):
            for key, value in overrides.items():
                if not isinstance(key, str) or not isinstance(value, str) or not value.strip():
                    self.errors.append("effective setting task.agentModelOverrides must map agent names to strings")
                else:
                    self.overrides[key] = value.strip()
        elif overrides is not None:
            self.errors.append("effective setting task.agentModelOverrides must be an object")

        disabled = self.settings.get("task.disabledAgents")
        if isinstance(disabled, list) and all(isinstance(item, str) and item for item in disabled):
            self.disabled = set(disabled)
        elif disabled is not None:
            self.errors.append("effective setting task.disabledAgents must be an array of agent names")

        depth = self.settings.get("task.maxRecursionDepth")
        if isinstance(depth, bool) or not isinstance(depth, int):
            if depth is not None:
                self.errors.append("effective setting task.maxRecursionDepth must be an integer")
        elif depth >= 0 and depth < self.minimum_depth:
            self.errors.append(
                f"task.maxRecursionDepth must be at least {self.minimum_depth} for the {self.workflow} dispatch graph"
            )

        self.agent_advisor = self.settings.get("task.agentAdvisor")
        self.agent_prewalk = self.settings.get("task.agentPrewalk")
        for name, value in (("task.agentAdvisor", self.agent_advisor), ("task.agentPrewalk", self.agent_prewalk)):
            if value is not None and not isinstance(value, (dict, bool, str)):
                self.errors.append(f"effective setting {name} must be an object, boolean, or string")

    @staticmethod
    def _enabled(value: Any) -> bool:
        if isinstance(value, str):
            return value.strip().lower() not in ("", "off", "false", "0", "none", "disabled")
        return bool(value)

    @staticmethod
    def _agent_value(value: Any, agent: str) -> tuple[bool, Any]:
        if isinstance(value, dict):
            return agent in value, value.get(agent)
        return True, value

    @staticmethod
    def _parse_frontmatter(path: Path) -> dict[str, Any]:
        text = path.read_text(encoding="utf-8")
        lines = text.splitlines()
        if not lines or lines[0].strip() != "---":
            raise ValueError("missing YAML frontmatter")
        try:
            end = next(index for index in range(1, len(lines)) if lines[index].strip() == "---")
        except StopIteration as exc:
            raise ValueError("unterminated YAML frontmatter") from exc
        fields: dict[str, Any] = {}
        index = 1
        while index < end:
            line = lines[index]
            if not line.strip() or line.lstrip().startswith("#"):
                index += 1
                continue
            if ":" not in line or line[0].isspace():
                raise ValueError(f"unsupported frontmatter line {line!r}")
            key, raw = line.split(":", 1)
            key = key.strip()
            raw = raw.strip()
            if not key or key in fields:
                raise ValueError(f"invalid or duplicate frontmatter field {key!r}")
            if raw:
                if raw.startswith("[") and raw.endswith("]"):
                    body = raw[1:-1].strip()
                    value = [] if not body else [item.strip().strip("\"'") for item in body.split(",")]
                else:
                    try:
                        value = ast.literal_eval(raw)
                    except (SyntaxError, ValueError):
                        value = raw.strip("\"'")
                fields[key] = value
                index += 1
                continue
            values: list[str] = []
            cursor = index + 1
            while cursor < end and (not lines[cursor].strip() or lines[cursor].startswith("  ")):
                child = lines[cursor].strip()
                if child:
                    if not child.startswith("-"):
                        raise ValueError(f"unsupported nested frontmatter field {child!r}")
                    values.append(child[1:].strip().strip("\"'"))
                cursor += 1
            fields[key] = values
            index = cursor
        return fields

    @staticmethod
    def _list_field(value: Any) -> tuple[str, ...] | None:
        if value is None:
            return ()
        if isinstance(value, list) and all(isinstance(item, str) and item for item in value):
            return tuple(value)
        if isinstance(value, str):
            return tuple(item.strip() for item in value.split(",") if item.strip())
        return None

    def load_profiles(self) -> None:
        profile_dir = self.repo / ".omp" / "agents"
        for contract in self.contracts:
            path = profile_dir / f"{contract.name}.md"
            if not path.is_file():
                self.errors.append(f"required profile is missing: {path}")
                continue
            try:
                self.profile_data[contract.name] = self._parse_frontmatter(path)
            except (OSError, ValueError) as exc:
                self.errors.append(f"profile {contract.name!r} is malformed: {exc}")

    @staticmethod
    def _split_suffix(value: str) -> tuple[str, str | None, str | None]:
        match = THINKING_SUFFIX.search(value)
        if not match:
            return value, None, None
        suffix = match.group(1).lower()
        if suffix not in THINKING_LEVELS:
            return value[: match.start()], suffix, "unsupported thinking suffix"
        return value[: match.start()], suffix, None

    def resolve(self, requested: str, agent: str) -> tuple[str | None, str | None, str | None]:
        seen: list[str] = []

        def visit(value: str, inherited: str | None = None) -> tuple[str | None, str | None, str | None]:
            base, suffix, issue = self._split_suffix(value.strip())
            if issue:
                return None, suffix, f"agent {agent!r} uses unsupported thinking suffix :{suffix}"
            effective_suffix = inherited or suffix
            if base == "*":
                base = "@default"
            if not base.startswith("@"):
                return base, effective_suffix, None
            role = base[1:]
            if not role:
                return None, effective_suffix, f"agent {agent!r} has an empty model role alias"
            if role in seen:
                chain = " -> ".join("@" + item for item in (*seen, role))
                return None, effective_suffix, f"agent {agent!r} has a model role cycle: {chain}"
            if role not in self.roles:
                return None, effective_suffix, f"agent {agent!r} references missing model role @{role}"
            seen.append(role)
            resolved = visit(self.roles[role], effective_suffix)
            seen.pop()
            return resolved

        return visit(requested)

    @staticmethod
    def _thinking_levels(model: dict[str, Any]) -> set[str] | None:
        value = model.get("thinking")
        if isinstance(value, list) and all(isinstance(item, str) for item in value):
            return {item.lower() for item in value}
        if isinstance(value, dict):
            for key in ("efforts", "levels", "supported"):
                candidate = value.get(key)
                if isinstance(candidate, list) and all(isinstance(item, str) for item in candidate):
                    return {item.lower() for item in candidate}
            default = value.get("defaultLevel")
            return {default.lower()} if isinstance(default, str) else None
        if isinstance(value, str):
            return {value.lower()}
        if value is False or value is None:
            return set()
        return None

    @staticmethod
    def _model_summary(model: dict[str, Any]) -> dict[str, Any]:
        return {key: model[key] for key in ("selector", "provider", "id", "thinking")}

    def check_agents(self) -> dict[str, Any]:
        agents: dict[str, Any] = {}
        for contract in self.contracts:
            profile = self.profile_data.get(contract.name, {})
            requested = self.overrides.get(contract.name, profile.get("model"))
            agent_errors: list[str] = []
            detail: dict[str, Any] = {
                "requested": requested,
                "resolved": None,
                "available": False,
                "tools": self._list_field(profile.get("tools")),
                "spawns": self._list_field(profile.get("spawns")),
                "errors": agent_errors,
            }
            if profile:
                if profile.get("name") != contract.name:
                    agent_errors.append(f"profile must declare name {contract.name!r}")
                description = profile.get("description")
                if not isinstance(description, str) or not description.strip():
                    agent_errors.append("profile must declare a nonempty description")
                if profile.get("model") != contract.model:
                    agent_errors.append(
                        f"profile must request exact model alias {contract.model!r}; got {profile.get('model')!r}"
                    )
                tools = self._list_field(profile.get("tools"))
                if tools is None or set(tools) != set(contract.tools):
                    agent_errors.append(f"profile tools must be exactly {list(contract.tools)!r}; got {tools!r}")
                spawns = self._list_field(profile.get("spawns"))
                if spawns is None or tuple(spawns) != contract.spawns:
                    agent_errors.append(f"profile must spawn exactly {list(contract.spawns)!r}; got {spawns!r}")
                for setting in ("advisor", "prewalk"):
                    if setting in profile and self._enabled(profile[setting]):
                        agent_errors.append(f"profile enables {setting}; fixed dispatch requires it off")

            if contract.name in self.disabled:
                agent_errors.append("profile is disabled by task.disabledAgents")
            for setting, value in (("advisor", self.agent_advisor), ("prewalk", self.agent_prewalk)):
                is_set, effective = self._agent_value(value, contract.name)
                if is_set and self._enabled(effective):
                    agent_errors.append(f"task.agent{setting.title()} enables {setting}; fixed dispatch requires it off")

            if not isinstance(requested, str) or not requested.strip():
                agent_errors.append("agent has no effective model request")
            else:
                if requested != contract.model:
                    agent_errors.append(
                        f"effective model request is {requested!r}; exact contract requires {contract.model!r}"
                    )
                resolved, thinking, issue = self.resolve(requested, contract.name)
                detail["role"] = requested[1:] if requested.startswith("@") else None
                detail["resolved"] = resolved
                if thinking is not None:
                    detail["thinking"] = thinking
                if issue:
                    agent_errors.append(issue)
                if resolved is not None:
                    matches = [
                        model
                        for model in self.models
                        if model.get("selector") == resolved
                        or f"{model.get('provider')}/{model.get('id')}" == resolved
                    ]
                    if thinking is not None and thinking != "off":
                        matches = [model for model in matches if thinking in (self._thinking_levels(model) or set())]
                    detail["available"] = bool(matches)
                    detail["available_models"] = [self._model_summary(model) for model in matches]
                    if not matches:
                        suffix = f":{thinking}" if thinking else ""
                        agent_errors.append(f"resolved model {resolved!r}{suffix} is unavailable")
            if agent_errors:
                self.errors.extend(f"agent {contract.name!r}: {error}" for error in agent_errors)
            agents[contract.name] = detail
        return agents

    def relevant_roles(self) -> dict[str, str]:
        result: dict[str, str] = {}
        for contract in self.contracts:
            value = self.overrides.get(contract.name, self.profile_data.get(contract.name, {}).get("model"))
            seen: set[str] = set()
            while isinstance(value, str):
                base, _, _ = self._split_suffix(value.strip())
                if not base.startswith("@"):
                    break
                role = base[1:]
                if not role or role in seen or role not in self.roles:
                    break
                seen.add(role)
                result[role] = self.roles[role]
                value = self.roles[role]
        return {key: result[key] for key in sorted(result)}

    def relevant_settings(self, roles: dict[str, str]) -> dict[str, Any]:
        selected_agents = {contract.name for contract in self.contracts}
        result: dict[str, Any] = {}
        for path, value in self.settings.items():
            if path == "modelRoles":
                result[path] = roles
            elif path in ("task.agentModelOverrides", "task.agentAdvisor", "task.agentPrewalk") and isinstance(value, dict):
                result[path] = {key: value[key] for key in sorted(value) if key in selected_agents}
            elif path == "task.disabledAgents" and isinstance(value, list):
                result[path] = [name for name in value if name in selected_agents]
            else:
                result[path] = value
        return result

    @staticmethod
    def relevant_models(agents: dict[str, Any]) -> list[dict[str, Any]]:
        by_selector: dict[str, dict[str, Any]] = {}
        for detail in agents.values():
            for model in detail.get("available_models", ()):
                by_selector[model["selector"]] = model
        return [by_selector[key] for key in sorted(by_selector)]

    def result(self) -> dict[str, Any]:
        git = self.load_git()
        self.load_effective_data()
        self.parse_settings()
        self.load_profiles()
        agents = self.check_agents()
        roles = self.relevant_roles()
        errors = sorted(dict.fromkeys(self.errors))
        return {
            "schema_version": 1,
            "workflow": self.workflow,
            "ok": not errors,
            "git": git,
            "settings": self.relevant_settings(roles),
            "roles": roles,
            "model_count": len(self.models),
            "models": self.relevant_models(agents),
            "agents": agents,
            "errors": errors,
        }


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument("--repo", default=Path.cwd(), type=Path, help="repository to inspect (default: current directory)")
    result.add_argument("--workflow", choices=tuple(WORKFLOWS), default="boss", help="profile contract to validate")
    result.add_argument("--omp", default="omp", help="omp executable (or test double)")
    result.add_argument("--pretty", action="store_true", help="indent the JSON result")
    return result


def main() -> int:
    args = parser().parse_args()
    if not args.repo.is_dir():
        payload = {
            "schema_version": 1,
            "workflow": args.workflow,
            "ok": False,
            "git": {},
            "settings": {},
            "roles": {},
            "models": [],
            "model_count": 0,
            "agents": {},
            "errors": [f"repository is not a directory: {args.repo}"],
        }
    else:
        payload = Preflight(args.repo, args.omp, args.workflow).result()
    json.dump(payload, sys.stdout, indent=2 if args.pretty else None, sort_keys=True)
    sys.stdout.write("\n")
    return 0 if payload["ok"] else 2


if __name__ == "__main__":
    raise SystemExit(main())
