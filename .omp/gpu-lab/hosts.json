{
  "version": 1,
  "defaults": {
    "remote_root": "/home/omp-gpu/gpu-lab",
    "lock_timeout_seconds": 7200,
    "jobs": 16,
    "rsync_compress": true
  },
  "hosts": {
    "cuda-rtx": {
      "enabled": false,
      "ssh_alias": "cuda-rtx",
      "description": "NVIDIA RTX CUDA validation host",
      "backend": "cuda",
      "gpu_index": "0",
      "lock_name": "cuda-gpu-0",
      "profile": "cuda-debug",
      "benchmark_profile": "cuda-release",
      "remote_root": "/home/omp-gpu/gpu-lab",
      "native_omp_ssh": {
        "host": "cuda-rtx",
        "user": "omp-gpu",
        "port": 22,
        "key": "~/.ssh/id_ed25519_gpu_lab"
      },
      "debug_adapters": [
        {
          "name": "host-gdb",
          "enabled": true,
          "command": "/usr/bin/gdb",
          "languages": ["c", "cpp"],
          "file_types": [".c", ".cc", ".cpp", ".cxx"],
          "experimental": false
        },
        {
          "name": "cuda-gdb",
          "enabled": false,
          "command": "/usr/local/cuda/bin/cuda-gdb",
          "languages": ["c", "cpp", "cuda"],
          "file_types": [".c", ".cc", ".cpp", ".cxx", ".cu"],
          "experimental": true
        }
      ]
    },
    "rocm-radeon": {
      "enabled": false,
      "ssh_alias": "rocm-radeon",
      "description": "AMD Radeon ROCm validation host",
      "backend": "rocm",
      "gpu_index": "0",
      "lock_name": "rocm-gpu-0",
      "profile": "rocm-debug",
      "benchmark_profile": "rocm-release",
      "remote_root": "/home/omp-gpu/gpu-lab",
      "native_omp_ssh": {
        "host": "rocm-radeon",
        "user": "omp-gpu",
        "port": 22,
        "key": "~/.ssh/id_ed25519_gpu_lab"
      },
      "debug_adapters": [
        {
          "name": "rocgdb",
          "enabled": true,
          "command": "/opt/rocm/bin/rocgdb",
          "languages": ["c", "cpp", "hip"],
          "file_types": [".c", ".cc", ".cpp", ".cxx", ".hip"],
          "experimental": false
        }
      ]
    }
  }
}
