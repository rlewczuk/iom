#!/usr/bin/env bash
set -Eeuo pipefail
root="${GPU_LAB_PROJECT_ROOT:-$PWD}"
while [[ "$root" != / && ! -f "$root/.omp/gpu-lab/omp-config.yml" ]]; do
  root="$(dirname -- "$root")"
done
[[ -f "$root/.omp/gpu-lab/omp-config.yml" ]] || {
  echo "omp-gpu: cannot find .omp/gpu-lab/omp-config.yml" >&2
  exit 1
}
[[ -x "$root/.omp/gpu-lab/bin/gpu-lab-cost" ]] || {
  echo "omp-gpu: missing .omp/gpu-lab/bin/gpu-lab-cost; reinstall package" >&2
  exit 1
}
cd -- "$root"
.omp/gpu-lab/bin/gpu-lab-cost apply >/dev/null
exec omp --config .omp/gpu-lab/omp-config.yml "$@"
