#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  echo "Usage: gpu-lab-init [PROJECT] [--enable-ssh-mcp] [--register-native-ssh]"
}

project="$PWD"
enable_mcp=false
register=false
if [[ $# -gt 0 && "$1" != --* ]]; then project="$1"; shift; fi
while [[ $# -gt 0 ]]; do
  case "$1" in
    --enable-ssh-mcp) enable_mcp=true ;;
    --register-native-ssh) register=true ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage; exit 2 ;;
  esac
  shift
done

[[ -d "$project" ]] || { echo "Project not found: $project" >&2; exit 1; }
project="$(cd -- "$project" && pwd)"
source_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
target_root="$project/.omp/gpu-lab"
mkdir -p "$target_root"

# A globally installed helper must seed the complete project-local runtime.
# A project-local invocation already points at the target and skips this copy.
if [[ "$source_root" != "$target_root" ]]; then
  for part in bin scripts templates; do
    rm -rf -- "$target_root/$part"
    cp -a -- "$source_root/$part" "$target_root/$part"
    echo "installed $target_root/$part"
  done
fi

templates="$target_root/templates"
mkdir -p "$target_root/results" "$target_root/generated"
for name in hosts.json project.json cost-policy.json exploration-policy.json omp-config.yml ssh-config.fragment; do
  if [[ ! -e "$target_root/$name" ]]; then
    cp -a -- "$templates/$name" "$target_root/$name"
    echo "created $target_root/$name"
  else
    echo "preserved $target_root/$name"
  fi
done

args=(--project "$project")
$enable_mcp && args+=(--enable-ssh-mcp)
$register && args+=(--register-native-ssh)
"$target_root/bin/gpu-lab-cost" --project "$project" upgrade
"$target_root/bin/gpu-lab-cost" --project "$project" apply
"$target_root/bin/gpu-lab-explore" --project "$project" apply
"$target_root/bin/gpu-lab-explore" --project "$project" init-docs
"$target_root/bin/gpu-lab-configure" "${args[@]}"
echo "Edit $target_root/hosts.json, project.json, omp-config.yml, cost-policy.json, and exploration-policy.json."
echo "Run $target_root/bin/gpu-lab-cost show, then rerun gpu-lab-configure."
