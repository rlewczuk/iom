#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'USAGE'
Usage:
  gpu-labctl list [--json]
  gpu-labctl doctor HOST|--all
  gpu-labctl sync HOST [--run-id ID]
  gpu-labctl validate HOST [--run-id ID] [--profile NAME] [--phase PHASE]
                              [--change CHANGE_ID] [--task TASK_ID]
  gpu-labctl validate-all [--run-id ID] [--phase PHASE]
                          [--change CHANGE_ID] [--task TASK_ID]
  gpu-labctl benchmark HOST [validate options]
  gpu-labctl latest HOST [--json]
  gpu-labctl debug-plan HOST PROGRAM [--run-id ID]

PHASE is configure, build, test, benchmark, or all.
Configuration:
  .omp/gpu-lab/hosts.json
  .omp/gpu-lab/project.json
USAGE
}

die() {
  printf 'gpu-labctl: %s\n' "$*" >&2
  exit 1
}

note() {
  printf '[gpu-lab] %s\n' "$*" >&2
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

find_project_root() {
  if [[ -n "${GPU_LAB_PROJECT_ROOT:-}" ]]; then
    (cd -- "$GPU_LAB_PROJECT_ROOT" && pwd)
    return
  fi

  local candidate
  candidate="$PWD"
  while [[ "$candidate" != "/" ]]; do
    if [[ -f "$candidate/.omp/gpu-lab/hosts.json" && -f "$candidate/.omp/gpu-lab/project.json" ]]; then
      printf '%s\n' "$candidate"
      return
    fi
    candidate="$(dirname -- "$candidate")"
  done

  if git_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    printf '%s\n' "$git_root"
    return
  fi

  die "cannot locate project root; run from a configured project or set GPU_LAB_PROJECT_ROOT"
}

PROJECT_ROOT="$(find_project_root)"
HOSTS_FILE="${GPU_LAB_HOSTS_FILE:-$PROJECT_ROOT/.omp/gpu-lab/hosts.json}"
PROJECT_FILE="${GPU_LAB_PROJECT_FILE:-$PROJECT_ROOT/.omp/gpu-lab/project.json}"
RESULTS_ROOT="${GPU_LAB_RESULTS_ROOT:-$PROJECT_ROOT/.omp/gpu-lab/results}"

validate_config() {
  [[ -f "$HOSTS_FILE" ]] || die "missing host inventory: $HOSTS_FILE"
  [[ -f "$PROJECT_FILE" ]] || die "missing project config: $PROJECT_FILE"
  jq -e '.version == 1 and (.hosts | type == "object")' "$HOSTS_FILE" >/dev/null \
    || die "invalid hosts.json"
  jq -e '.version == 1 and (.profiles | type == "object")' "$PROJECT_FILE" >/dev/null \
    || die "invalid project.json"
}

host_exists() {
  local host="$1"
  jq -e --arg host "$host" '.hosts[$host] != null' "$HOSTS_FILE" >/dev/null
}

host_json() {
  local host="$1"
  jq -cer --arg host "$host" '.hosts[$host]' "$HOSTS_FILE"
}

host_value() {
  local host="$1" key="$2" fallback_expr="${3:-empty}"
  jq -er --arg host "$host" --arg key "$key" \
    ".hosts[\$host][\$key] // .defaults[\$key] // ($fallback_expr)" "$HOSTS_FILE"
}

enabled_hosts() {
  jq -r '.hosts | to_entries[] | select(.value.enabled == true) | .key' "$HOSTS_FILE"
}

assert_host() {
  local host="$1"
  host_exists "$host" || die "unknown host '$host'"
  [[ "$(host_value "$host" enabled false)" == "true" ]] \
    || die "host '$host' is disabled in $HOSTS_FILE"
}

assert_identifier() {
  local label="$1" value="$2"
  [[ "$value" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$ ]] \
    || die "$label must use 1-120 letters, numbers, '.', '_' or '-'"
}

new_run_id() {
  local revision="nogit"
  revision="$(git -C "$PROJECT_ROOT" rev-parse --short HEAD 2>/dev/null || printf nogit)"
  printf '%s-%s-%05d\n' "$(date -u +%Y%m%dT%H%M%SZ)" "$revision" "$((RANDOM % 100000))"
}

remote_exec() {
  local alias="$1"
  shift
  ssh -o BatchMode=yes -o ConnectTimeout=15 "$alias" "$@"
}

source_dir() {
  local configured
  configured="$(jq -er '.source_root // "."' "$PROJECT_FILE")"
  (cd -- "$PROJECT_ROOT/$configured" && pwd)
}

local_result_dir() {
  local host="$1" run_id="$2" change_id="$3" task_id="$4"
  if [[ -n "$change_id" ]]; then
    local base="$PROJECT_ROOT/.specs/$change_id/gpu-lab/$run_id/$host"
    if [[ -n "$task_id" ]]; then
      base="$base/task-$task_id"
    fi
    printf '%s\n' "$base"
  else
    printf '%s/%s/%s\n' "$RESULTS_ROOT" "$run_id" "$host"
  fi
}

make_run_config() {
  local host="$1" profile="$2" run_id="$3" phase="$4" output="$5"
  local hjson pjson
  hjson="$(host_json "$host")"
  pjson="$(jq -cer --arg profile "$profile" '.profiles[$profile]' "$PROJECT_FILE")" \
    || die "unknown profile '$profile'"

  local backend profile_backend
  backend="$(jq -r '.backend' <<<"$hjson")"
  profile_backend="$(jq -r '.backend' <<<"$pjson")"
  [[ "$backend" == "$profile_backend" ]] \
    || die "host '$host' backend '$backend' does not match profile '$profile' backend '$profile_backend'"

  jq -n \
    --arg host_id "$host" \
    --arg run_id "$run_id" \
    --arg phase "$phase" \
    --arg profile_name "$profile" \
    --arg local_project_root "$PROJECT_ROOT" \
    --argjson host "$hjson" \
    --argjson profile "$pjson" \
    --argjson defaults "$(jq -c '.defaults // {}' "$HOSTS_FILE")" \
    '{
       version: 1,
       host_id: $host_id,
       run_id: $run_id,
       phase: $phase,
       profile_name: $profile_name,
       local_project_root: $local_project_root,
       host: $host,
       profile: $profile,
       defaults: $defaults
     }' > "$output"
}

rsync_source() {
  local host="$1" run_id="$2" run_config="$3"
  local alias remote_root remote_src compress checksum delete_flag
  alias="$(host_value "$host" ssh_alias)"
  remote_root="$(host_value "$host" remote_root '"/home/omp-gpu/gpu-lab"')"
  remote_src="$remote_root/runs/$run_id/src"
  compress="$(host_value "$host" rsync_compress true)"
  checksum="$(jq -r '.sync.checksum // false' "$PROJECT_FILE")"
  delete_flag="$(jq -r '.sync.delete // true' "$PROJECT_FILE")"

  remote_exec "$alias" \
    "mkdir -p '$remote_src' '$remote_root/runs/$run_id/logs' '$remote_root/runs/$run_id/results' '$remote_root/runs/$run_id/build' '$remote_root/cache/ccache' '$remote_root/locks'"

  local -a opts=(-a --partial --human-readable)
  [[ "$compress" == "true" ]] && opts+=(-z)
  [[ "$checksum" == "true" ]] && opts+=(--checksum)
  [[ "$delete_flag" == "true" ]] && opts+=(--delete --delete-excluded)

  while IFS= read -r exclude; do
    [[ -n "$exclude" ]] && opts+=(--exclude "$exclude")
  done < <(jq -r '.sync.excludes[]? // empty' "$PROJECT_FILE")

  local src
  src="$(source_dir)"
  note "syncing $src to $host:$remote_src"
  rsync "${opts[@]}" -e ssh "$src/" "$alias:$remote_src/"
  rsync -a -e ssh "$run_config" "$alias:$remote_root/runs/$run_id/run-config.json"

  remote_exec "$alias" "ln -sfn '$remote_root/runs/$run_id' '$remote_root/current'"
}

remote_runner() {
  cat <<'REMOTE_SCRIPT'
set -Eeuo pipefail

run_config="$1"
run_root="$(dirname -- "$run_config")"
source_dir="$run_root/src"
build_dir="$run_root/build"
logs_dir="$run_root/logs"
results_dir="$run_root/results"
mkdir -p "$logs_dir" "$results_dir" "$build_dir"

host_id="$(jq -r '.host_id' "$run_config")"
run_id="$(jq -r '.run_id' "$run_config")"
phase="$(jq -r '.phase' "$run_config")"
profile_name="$(jq -r '.profile_name' "$run_config")"
backend="$(jq -r '.host.backend' "$run_config")"
gpu_index="$(jq -r '.host.gpu_index // "0"' "$run_config")"
remote_root="$(jq -r '.host.remote_root // .defaults.remote_root // "/home/omp-gpu/gpu-lab"' "$run_config")"
lock_name="$(jq -r '.host.lock_name // (.host.backend + "-gpu-" + (.host.gpu_index // "0"))' "$run_config")"
lock_timeout="$(jq -r '.host.lock_timeout_seconds // .defaults.lock_timeout_seconds // 7200' "$run_config")"
jobs="$(jq -r '.host.jobs // .defaults.jobs // 16' "$run_config")"

export GPU_LAB_HOST_ID="$host_id"
export GPU_LAB_RUN_ID="$run_id"
export GPU_LAB_BACKEND="$backend"
export GPU_LAB_GPU_INDEX="$gpu_index"
export GPU_LAB_REMOTE_ROOT="$remote_root"
export GPU_LAB_RUN_ROOT="$run_root"
export GPU_LAB_SOURCE_DIR="$source_dir"
export GPU_LAB_BUILD_DIR="$build_dir/$profile_name"
export GPU_LAB_PROFILE="$profile_name"
export GPU_LAB_JOBS="$jobs"
export CCACHE_DIR="$remote_root/cache/ccache"
export CCACHE_BASEDIR="$source_dir"
export CCACHE_COMPRESS=1

if [[ "$backend" == "cuda" ]]; then
  export CUDA_VISIBLE_DEVICES="$gpu_index"
elif [[ "$backend" == "rocm" ]]; then
  export HIP_VISIBLE_DEVICES="$gpu_index"
  export ROCR_VISIBLE_DEVICES="$gpu_index"
fi

inventory="$results_dir/inventory.txt"
{
  printf 'timestamp=%s\n' "$(date -u +%FT%TZ)"
  printf 'host_id=%s\n' "$host_id"
  printf 'hostname=%s\n' "$(hostname)"
  printf 'architecture=%s\n' "$(uname -m)"
  uname -a
  if command -v lsb_release >/dev/null 2>&1; then lsb_release -a 2>/dev/null || true; fi
  for command in cmake ninja c++ gcc g++ clang clang++ clangd ccache gdb gdbserver lldb-dap; do
    if command -v "$command" >/dev/null 2>&1; then
      printf '\n=== %s ===\n' "$command"
      "$command" --version 2>&1 | head -20 || true
    fi
  done
  if [[ "$backend" == "cuda" ]]; then
    command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi || true
    command -v nvcc >/dev/null 2>&1 && nvcc --version || true
    command -v cuda-gdb >/dev/null 2>&1 && cuda-gdb --version | head -20 || true
    command -v compute-sanitizer >/dev/null 2>&1 && compute-sanitizer --version || true
  else
    command -v rocminfo >/dev/null 2>&1 && rocminfo | head -200 || true
    command -v hipcc >/dev/null 2>&1 && hipcc --version || true
    command -v rocgdb >/dev/null 2>&1 && rocgdb --version | head -20 || true
    command -v amd-smi >/dev/null 2>&1 && amd-smi version || true
  fi
} >"$inventory" 2>&1

lock_file="$remote_root/locks/$lock_name.lock"
exec 9>"$lock_file"
if ! flock -w "$lock_timeout" 9; then
  jq -n \
    --arg host "$host_id" --arg run_id "$run_id" --arg profile "$profile_name" \
    --arg backend "$backend" --arg status "blocked" \
    --arg reason "timed out waiting for $lock_file" \
    '{host:$host,run_id:$run_id,profile:$profile,backend:$backend,status:$status,reason:$reason}' \
    > "$results_dir/result.json"
  cat "$results_dir/result.json"
  exit 75
fi

started="$(date -u +%FT%TZ)"
declare -A statuses=([configure]=not_requested [build]=not_requested [test]=not_requested [benchmark]=not_requested)
declare -A exit_codes=([configure]=0 [build]=0 [test]=0 [benchmark]=0)
overall=passed
first_failure=0

run_phase() {
  local name="$1"
  local command
  command="$(jq -r --arg name "$name" '.profile[$name] // ""' "$run_config")"
  if [[ -z "$command" ]]; then
    statuses[$name]=skipped
    return 0
  fi

  statuses[$name]=running
  local log="$logs_dir/$name.log"
  {
    printf 'host=%s\nrun_id=%s\nprofile=%s\nphase=%s\ncommand=%s\nstarted=%s\n\n' \
      "$host_id" "$run_id" "$profile_name" "$name" "$command" "$(date -u +%FT%TZ)"
    cd -- "$source_dir"
    bash -lc "$command"
  } >"$log" 2>&1
  local rc=$?
  exit_codes[$name]=$rc
  if [[ $rc -eq 0 ]]; then
    statuses[$name]=passed
  else
    statuses[$name]=failed
    overall=failed
    [[ $first_failure -eq 0 ]] && first_failure=$rc
  fi
  return "$rc"
}

set +e
case "$phase" in
  configure)
    run_phase configure
    ;;
  build)
    run_phase configure && run_phase build
    ;;
  test|all)
    run_phase configure && run_phase build && run_phase test
    ;;
  benchmark)
    run_phase configure && run_phase build && run_phase benchmark
    ;;
  *)
    overall=failed
    first_failure=2
    ;;
esac
set -e

finished="$(date -u +%FT%TZ)"
jq -n \
  --arg host "$host_id" \
  --arg run_id "$run_id" \
  --arg profile "$profile_name" \
  --arg backend "$backend" \
  --arg gpu_index "$gpu_index" \
  --arg status "$overall" \
  --arg started "$started" \
  --arg finished "$finished" \
  --arg source_dir "$source_dir" \
  --arg build_dir "$GPU_LAB_BUILD_DIR" \
  --arg inventory "$inventory" \
  --arg configure_status "${statuses[configure]}" \
  --arg build_status "${statuses[build]}" \
  --arg test_status "${statuses[test]}" \
  --arg benchmark_status "${statuses[benchmark]}" \
  --argjson configure_exit "${exit_codes[configure]}" \
  --argjson build_exit "${exit_codes[build]}" \
  --argjson test_exit "${exit_codes[test]}" \
  --argjson benchmark_exit "${exit_codes[benchmark]}" \
  '{
    host:$host,
    run_id:$run_id,
    profile:$profile,
    backend:$backend,
    gpu_index:$gpu_index,
    status:$status,
    started:$started,
    finished:$finished,
    source_dir:$source_dir,
    build_dir:$build_dir,
    inventory:$inventory,
    phases:{
      configure:{status:$configure_status,exit_code:$configure_exit},
      build:{status:$build_status,exit_code:$build_exit},
      test:{status:$test_status,exit_code:$test_exit},
      benchmark:{status:$benchmark_status,exit_code:$benchmark_exit}
    }
  }' > "$results_dir/result.json"

cat "$results_dir/result.json"
exit "$first_failure"
REMOTE_SCRIPT
}

collect_run() {
  local host="$1" run_id="$2" change_id="$3" task_id="$4"
  local alias remote_root local_dir
  alias="$(host_value "$host" ssh_alias)"
  remote_root="$(host_value "$host" remote_root '"/home/omp-gpu/gpu-lab"')"
  local_dir="$(local_result_dir "$host" "$run_id" "$change_id" "$task_id")"
  mkdir -p "$local_dir"

  rsync -a -e ssh "$alias:$remote_root/runs/$run_id/results/" "$local_dir/"
  rsync -a -e ssh "$alias:$remote_root/runs/$run_id/logs/" "$local_dir/logs/"
  rsync -a -e ssh "$alias:$remote_root/runs/$run_id/run-config.json" "$local_dir/run-config.json"

  jq -n \
    --arg host "$host" --arg run_id "$run_id" \
    --arg collected_at "$(date -u +%FT%TZ)" \
    --arg project_root "$PROJECT_ROOT" \
    '{host:$host,run_id:$run_id,collected_at:$collected_at,project_root:$project_root}' \
    > "$local_dir/collection.json"

  note "artifacts: $local_dir"
}

sync_command() {
  local host="$1" run_id="$2"
  assert_host "$host"
  assert_identifier "run ID" "$run_id"
  local tmp
  tmp="$(mktemp)"
  local profile
  profile="$(host_value "$host" profile)"
  if ! make_run_config "$host" "$profile" "$run_id" all "$tmp"; then
    rm -f -- "$tmp"
    return 1
  fi
  if ! rsync_source "$host" "$run_id" "$tmp"; then
    rm -f -- "$tmp"
    return 1
  fi
  rm -f -- "$tmp"
}

validate_command() {
  local host="$1" run_id="$2" profile="$3" phase="$4" change_id="$5" task_id="$6"
  assert_host "$host"
  assert_identifier "run ID" "$run_id"
  [[ -z "$change_id" ]] || assert_identifier "change ID" "$change_id"
  [[ -z "$task_id" ]] || assert_identifier "task ID" "$task_id"
  [[ "$phase" =~ ^(configure|build|test|benchmark|all)$ ]] || die "invalid phase '$phase'"

  if [[ -z "$profile" ]]; then
    if [[ "$phase" == benchmark ]]; then
      profile="$(host_value "$host" benchmark_profile)"
    else
      profile="$(host_value "$host" profile)"
    fi
  fi

  local tmp alias remote_root
  tmp="$(mktemp)"
  if ! make_run_config "$host" "$profile" "$run_id" "$phase" "$tmp"; then
    rm -f -- "$tmp"
    return 1
  fi
  if ! rsync_source "$host" "$run_id" "$tmp"; then
    rm -f -- "$tmp"
    return 1
  fi
  rm -f -- "$tmp"

  alias="$(host_value "$host" ssh_alias)"
  remote_root="$(host_value "$host" remote_root '"/home/omp-gpu/gpu-lab"')"

  note "running $phase on $host with profile $profile and run ID $run_id"
  set +e
  remote_runner | remote_exec "$alias" bash -s -- "$remote_root/runs/$run_id/run-config.json"
  local rc=${PIPESTATUS[1]}
  set -e

  collect_run "$host" "$run_id" "$change_id" "$task_id" || note "artifact collection failed"
  return "$rc"
}

doctor_host() {
  local host="$1"
  assert_host "$host"
  local alias backend
  alias="$(host_value "$host" ssh_alias)"
  backend="$(host_value "$host" backend)"

  note "checking $host via SSH alias $alias"
  remote_exec "$alias" bash -s -- "$backend" <<'DOCTOR'
set -u
backend="$1"
fail=0
warn=0

check_required() {
  local command="$1"
  if command -v "$command" >/dev/null 2>&1; then
    printf 'OK       %-22s %s\n' "$command" "$(command -v "$command")"
  else
    printf 'MISSING  %-22s required\n' "$command"
    fail=1
  fi
}

check_optional() {
  local command="$1"
  if command -v "$command" >/dev/null 2>&1; then
    printf 'OK       %-22s %s\n' "$command" "$(command -v "$command")"
  else
    printf 'OPTIONAL %-22s not found\n' "$command"
    warn=1
  fi
}

printf 'hostname=%s\n' "$(hostname)"
printf 'arch=%s\n' "$(uname -m)"
if [[ "$(uname -m)" != x86_64 ]]; then
  printf 'ERROR    expected amd64/x86_64\n'
  fail=1
fi
if command -v lsb_release >/dev/null 2>&1; then lsb_release -ds; fi

for command in bash ssh rsync jq flock cmake ninja c++ clang clang++ clangd clang-format clang-tidy ccache gdb gdbserver; do
  check_required "$command"
done
check_optional lldb-dap
check_optional tmux
check_optional numactl

if [[ "$backend" == cuda ]]; then
  for command in nvidia-smi nvcc cuda-gdb; do check_required "$command"; done
  check_optional cuda-gdbserver
  check_optional compute-sanitizer
  check_optional nsys
  check_optional ncu
  nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv 2>/dev/null || true
elif [[ "$backend" == rocm ]]; then
  for command in rocminfo hipcc rocgdb; do check_required "$command"; done
  check_optional amd-smi
  check_optional rocm-smi
  check_optional rocprofv3
  check_optional rocsys
  for group in render video; do
    if ! id -nG | tr ' ' '\n' | grep -Fxq "$group"; then
      printf 'MISSING  GPU group membership: %s (log in again after usermod)\n' "$group"
      fail=1
    fi
  done
  rocminfo 2>/dev/null | grep -E 'Name:|Marketing Name:|gfx[0-9]+' | head -40 || true
else
  printf 'ERROR    unknown backend: %s\n' "$backend"
  fail=1
fi

if [[ $fail -ne 0 ]]; then exit 1; fi
if [[ $warn -ne 0 ]]; then exit 3; fi
exit 0
DOCTOR
}

list_command() {
  local json="$1"
  if [[ "$json" == true ]]; then
    jq '.hosts' "$HOSTS_FILE"
    return
  fi
  jq -r '
    .hosts | to_entries[] |
    [.key, (.value.enabled|tostring), .value.backend, .value.ssh_alias, .value.profile, (.value.description // "")] |
    @tsv' "$HOSTS_FILE" \
  | awk -F '\t' 'BEGIN {printf "%-20s %-8s %-8s %-22s %-18s %s\n", "HOST", "ENABLED", "BACKEND", "SSH", "PROFILE", "DESCRIPTION"}
                    {printf "%-20s %-8s %-8s %-22s %-18s %s\n", $1,$2,$3,$4,$5,$6}'
}

latest_command() {
  local host="$1" json="$2"
  assert_host "$host"
  local alias remote_root
  alias="$(host_value "$host" ssh_alias)"
  remote_root="$(host_value "$host" remote_root '"/home/omp-gpu/gpu-lab"')"
  local target
  target="$(remote_exec "$alias" "readlink -f '$remote_root/current' 2>/dev/null || true")"
  [[ -n "$target" ]] || die "no current run on $host"
  if [[ "$json" == true ]]; then
    jq -n --arg host "$host" --arg path "$target" --arg run_id "$(basename -- "$target")" \
      '{host:$host,run_id:$run_id,path:$path}'
  else
    printf '%s\n' "$target"
  fi
}

debug_plan_command() {
  local host="$1" program="$2" run_id="$3"
  assert_host "$host"
  local alias remote_root run_root
  alias="$(host_value "$host" ssh_alias)"
  remote_root="$(host_value "$host" remote_root '"/home/omp-gpu/gpu-lab"')"
  if [[ -n "$run_id" ]]; then
    assert_identifier "run ID" "$run_id"
    run_root="$remote_root/runs/$run_id"
  else
    run_root="$(remote_exec "$alias" "readlink -f '$remote_root/current' 2>/dev/null || true")"
    [[ -n "$run_root" ]] || die "no current run on $host; validate first or pass --run-id"
    run_id="$(basename -- "$run_root")"
  fi

  local remote_program
  if [[ "$program" == /* ]]; then
    remote_program="$program"
  else
    remote_program="$run_root/src/$program"
  fi

  jq -n \
    --arg host "$host" --arg run_id "$run_id" --arg ssh_alias "$alias" \
    --arg run_root "$run_root" --arg program "$remote_program" \
    --argjson adapters "$(jq -c --arg host "$host" '[.hosts[$host].debug_adapters[]? | select(.enabled == true) | "gpu-lab-" + $host + "-" + .name]' "$HOSTS_FILE")" \
    '{
       host:$host,
       run_id:$run_id,
       ssh_alias:$ssh_alias,
       run_root:$run_root,
       program:$program,
       adapters:$adapters,
       instructions:[
         "Run gpu-lab-configure after changing hosts.json.",
         "Use one OMP debug session at a time.",
         "Pass the absolute remote program path to the debug launch action.",
         "Set local breakpoints only after source-path mapping has been verified."
       ]
     }'
}

parse_validate_options() {
  RUN_ID=""
  PROFILE=""
  PHASE="all"
  CHANGE_ID=""
  TASK_ID=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --run-id) RUN_ID="${2:?missing value for --run-id}"; shift 2 ;;
      --profile) PROFILE="${2:?missing value for --profile}"; shift 2 ;;
      --phase) PHASE="${2:?missing value for --phase}"; shift 2 ;;
      --change) CHANGE_ID="${2:?missing value for --change}"; shift 2 ;;
      --task) TASK_ID="${2:?missing value for --task}"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [[ -n "$RUN_ID" ]] || RUN_ID="$(new_run_id)"
}

main() {
  need jq
  validate_config

  local command="${1:-}"
  [[ -n "$command" ]] || { usage; exit 2; }
  shift

  case "$command" in
    list)
      local json=false
      [[ "${1:-}" == --json ]] && json=true
      list_command "$json"
      ;;
    doctor)
      need ssh
      local target="${1:-}"
      [[ -n "$target" ]] || die "doctor requires HOST or --all"
      if [[ "$target" == --all ]]; then
        local rc=0 host
        while IFS= read -r host; do
          doctor_host "$host" || rc=$?
        done < <(enabled_hosts)
        return "$rc"
      fi
      doctor_host "$target"
      ;;
    sync)
      need ssh
      need rsync
      local host="${1:-}"; [[ -n "$host" ]] || die "sync requires HOST"; shift
      local run_id=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --run-id) run_id="${2:?missing value}"; shift 2 ;;
          *) die "unknown option: $1" ;;
        esac
      done
      [[ -n "$run_id" ]] || run_id="$(new_run_id)"
      sync_command "$host" "$run_id"
      printf '%s\n' "$run_id"
      ;;
    validate|benchmark)
      need ssh
      need rsync
      local host="${1:-}"; [[ -n "$host" ]] || die "$command requires HOST"; shift
      parse_validate_options "$@"
      [[ "$command" == benchmark ]] && PHASE=benchmark
      validate_command "$host" "$RUN_ID" "$PROFILE" "$PHASE" "$CHANGE_ID" "$TASK_ID"
      ;;
    validate-all)
      need ssh
      need rsync
      parse_validate_options "$@"
      local -a pids=() names=()
      local host
      while IFS= read -r host; do
        validate_command "$host" "$RUN_ID" "" "$PHASE" "$CHANGE_ID" "$TASK_ID" &
        pids+=("$!")
        names+=("$host")
      done < <(enabled_hosts)
      [[ ${#pids[@]} -gt 0 ]] || die "no enabled hosts"
      local rc=0 i
      for i in "${!pids[@]}"; do
        if ! wait "${pids[$i]}"; then
          note "${names[$i]} failed"
          rc=1
        fi
      done
      printf 'run_id=%s\n' "$RUN_ID"
      return "$rc"
      ;;
    latest)
      need ssh
      local host="${1:-}"; [[ -n "$host" ]] || die "latest requires HOST"; shift
      local json=false
      [[ "${1:-}" == --json ]] && json=true
      latest_command "$host" "$json"
      ;;
    debug-plan)
      need ssh
      local host="${1:-}" program="${2:-}"
      [[ -n "$host" && -n "$program" ]] || die "debug-plan requires HOST PROGRAM"
      shift 2
      local run_id=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --run-id) run_id="${2:?missing value}"; shift 2 ;;
          *) die "unknown option: $1" ;;
        esac
      done
      debug_plan_command "$host" "$program" "$run_id"
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      die "unknown command '$command'"
      ;;
  esac
}

main "$@"
