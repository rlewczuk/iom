Host cuda-rtx
    HostName 192.168.20.31
    User omp-gpu
    IdentityFile ~/.ssh/id_ed25519_gpu_lab
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    ServerAliveInterval 20
    ServerAliveCountMax 3
    ConnectTimeout 10
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 15m

Host rocm-radeon
    HostName 192.168.20.32
    User omp-gpu
    IdentityFile ~/.ssh/id_ed25519_gpu_lab
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    ServerAliveInterval 20
    ServerAliveCountMax 3
    ConnectTimeout 10
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 15m
