  },
  "packages": {
    "jinja2": "3.1.6",
    "numpy": "1.26.4",
    "safetensors": "0.4.3",
    "sentencepiece": "0.2.0",
    "tokenizers": "0.19.1",
    "torch": "2.3.1+cpu",
    "transformers": "4.41.2"
  },
  "precision": {
    "activations": "BF16",
    "attention": "eager",
    "device": "cpu",
    "logits_storage": "BF16",
    "reference_arithmetic": "FP32",
    "weights": "BF16"
  },
  "prompts": {
    "chat": {
      "add_generation_prompt": true,
      "add_special_tokens": false,
      "assistant_prefix": "<|assistant|>\n",
      "expected_rendered": "<|user|>\nHello.</s>\n<|assistant|>\n",
      "max_new_tokens": 4,
      "messages": [
        {
          "content": "Hello.",
          "role": "user"
        }
      ],
      "mode": "chat"
    },
    "raw": {
      "add_special_tokens": true,
      "max_new_tokens": 4,
      "mode": "raw",
      "require_bos": true,
      "text": "The capital of France is"
    },
    "zero": {
      "add_special_tokens": true,
      "max_new_tokens": 0,
      "mode": "raw",
      "require_bos": true,
      "text": "The capital of France is"
    }
  },
  "schema_version": 1,
  "stop_policy": {
    "eos_before_max_new_tokens": true,
    "max_new_tokens_before_context_exhaustion": true,
    "terminal_token_no_kv_append": true,
    "zero_limit_no_forward": true
  },
  "tolerances": {
    "absolute": 0.25,
    "exact_token": "reference-margin-certified-only",
    "formula": "abs(actual-ref) <= 0.25 + 0.02*abs(ref)",
    "relative": 0.02,
    "tie_policy": "lowest-id"
  },
  "runtime": {
    "implementation": "CPython",
    "version": "3.12.3"
  }
}
